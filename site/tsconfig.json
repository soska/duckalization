{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@duckalization/id": ["../packages/id/src/index.ts"],
      "@duckalization/runtime": ["../packages/runtime/src/index.ts"],
      "@duckalization/react": ["../packages/react/src/index.ts"],
      "@duckalization/validate": ["../packages/translate/src/apply.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
