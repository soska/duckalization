{
  "$description": "Semantic colors, dark mode. Figma collection: Theme, mode: Dark. Keys must match theme.light.tokens.json.",
  "color": {
    "$type": "color",
    "surface": {
      "page": {
        "$value": "{color.brown.925}",
        "$description": "Page background."
      },
      "raised": {
        "$value": "{color.brown.850}",
        "$description": "Cards, inputs, panels that sit on the page."
      },
      "inverse": {
        "$value": "{color.brown.150}",
        "$description": "Ink fills: pressed segments, tabs."
      }
    },
    "text": {
      "default": {
        "$value": "{color.brown.150}",
        "$description": "Body text and ink."
      },
      "muted": {
        "$value": "{color.brown.400}",
        "$description": "Secondary text."
      },
      "inverse": {
        "$value": "{color.brown.925}",
        "$description": "Text on an ink (text.default) fill."
      },
      "on-accent": {
        "$value": "{color.brown.900}",
        "$description": "Text on the duck yellow, in both modes."
      },
      "on-color": {
        "$value": "{color.brown.850}",
        "$description": "Text on saturated fills (pond, danger)."
      }
    },
    "border": {
      "default": {
        "$value": "{color.brown.150}",
        "$description": "Sticker outlines and rules."
      },
      "subtle": {
        "$value": "{color.brown.800}",
        "$description": "Hairlines, dashed dividers, tracks."
      }
    },
    "shadow": {
      "sticker": {
        "$value": "{color.brown.150}",
        "$description": "Offset sticker shadows (see effects)."
      }
    },
    "accent": {
      "duck": {
        "$value": "{color.yellow.400}",
        "$description": "Duck yellow: primary actions, highlights."
      },
      "beak": {
        "$value": "{color.orange.400}",
        "$description": "Orange: eyebrows, links, the human."
      },
      "pond": {
        "$value": "{color.teal.300}",
        "$description": "Teal: the agent, success, focus."
      }
    },
    "status": {
      "danger": {
        "$value": "{color.red.400}",
        "$description": "Rejections and errors."
      },
      "success": {
        "$value": "{color.teal.300}",
        "$description": "Passed checks."
      },
      "warning": {
        "$value": "{color.orange.400}",
        "$description": "Warnings."
      }
    },
    "wash": {
      "pond": {
        "$value": "{color.teal.900}",
        "$description": "Teal tint on raised surfaces (agent areas, done steps)."
      },
      "danger": {
        "$value": "{color.red.400-a14}",
        "$description": "Translucent red behind flagged text."
      },
      "duck": {
        "$value": "{color.yellow.400-a34}",
        "$description": "Translucent yellow behind highlighted strings."
      }
    },
    "stamp": {
      "danger": {
        "$value": "{color.red.900}",
        "$description": "Rejected stamp fill."
      },
      "success": {
        "$value": "{color.teal.900}",
        "$description": "Applied stamp fill."
      },
      "warning": {
        "$value": "{color.orange.900}",
        "$description": "Warning stamp fill."
      }
    },
    "xray": {
      "bg": {
        "$value": "{color.pink.900}",
        "$description": "Fallback highlight fill."
      },
      "fg": {
        "$value": "{color.pink.200}",
        "$description": "Fallback highlight text and tags."
      }
    },
    "terminal": {
      "bg": {
        "$value": "{color.brown.950}",
        "$description": "Terminal and code background."
      },
      "fg": {
        "$value": "{color.brown.150}",
        "$description": "Terminal text."
      },
      "muted": {
        "$value": "{color.brown.550}",
        "$description": "Terminal secondary text, line numbers."
      },
      "divider": {
        "$value": "{color.brown.150-a20}",
        "$description": "Rules inside the terminal."
      },
      "ok": {
        "$value": "{color.green.300}",
        "$description": "Success output."
      },
      "err": {
        "$value": "{color.red.300}",
        "$description": "Error output."
      },
      "warn": {
        "$value": "{color.yellow.300}",
        "$description": "Warning output."
      },
      "hit": {
        "$value": "{color.yellow.500-a20}",
        "$description": "Highlighted code line."
      }
    }
  }
}
