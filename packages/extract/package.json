{
  "name": "@duckalization/extract",
  "version": "0.1.0",
  "type": "module",
  "description": "Extract translatable messages from source code into a content-addressed catalog.",
  "bin": {
    "duckalize": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@duckalization/id": "workspace:*",
    "oxc-parser": "^0.94.0",
    "picocolors": "^1.1.1",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsdown": "^0.15.12",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.19"
  }
}
