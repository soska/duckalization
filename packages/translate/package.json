    "@duckalization/id": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.10.3",
    "tsdown": "^0.15.12",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.19"
  }
}
