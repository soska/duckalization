{
  "name": "@duckalization/translate",
  "version": "0.1.0",
  "type": "module",
  "description": "Agent-driven catalog translation: status diffing, work-order briefs, glossary/style enforcement, validated apply, and review metadata.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@duckalization/extract": "workspace:*",
    "@duckalization/id": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.10.3",
    "tsdown": "^0.15.12",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.19"
  },
  "license": "MIT",
  "author": "Armando Sosa <arm.sosa@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soska/duckalization.git",
    "directory": "packages/translate"
  },
  "bugs": {
    "url": "https://github.com/soska/duckalization/issues"
  },
  "homepage": "https://github.com/soska/duckalization#readme",
  "keywords": [
    "duckalization",
    "i18n",
    "localization",
    "translation",
    "workflow",
    "catalog"
  ],
  "publishConfig": {
    "access": "public"
  }
}
