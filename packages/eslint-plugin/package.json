{
  "name": "@duckalization/eslint-plugin",
  "version": "0.1.0",
  "type": "module",
  "description": "ESLint rules that catch hardcoded UI strings before they ship unlocalizable, with keyless __() wrap suggestions.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc"
  },
  "peerDependencies": {
    "eslint": ">=9"
  },
  "devDependencies": {
    "@types/node": "^24.10.3",
    "eslint": "^9.0.0",
    "tsdown": "^0.15.12",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.19"
  },
  "license": "MIT",
  "author": "Armando Sosa <arm.sosa@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soska/duckalization.git",
    "directory": "packages/eslint-plugin"
  },
  "bugs": {
    "url": "https://github.com/soska/duckalization/issues"
  },
  "homepage": "https://github.com/soska/duckalization#readme",
  "keywords": [
    "duckalization",
    "eslint",
    "eslint-plugin",
    "i18n",
    "localization",
    "translation"
  ],
  "publishConfig": {
    "access": "public"
  }
}
